def options(ctx):
    ctx.load('pebble_sdk')

def configure(ctx):
    ctx.load('pebble_sdk')

def build(ctx):
    ctx.load('pebble_sdk')

    # The active SDK's report_memory_usage feature indexes env.PLATFORM as a
    # dict but it is a list, which crashes the build. The memory report is
    # cosmetic; disable it and check RAM usage via `arm-none-eabi-size` instead.
    from waflib import TaskGen
    TaskGen.feats['memory_usage'].clear()

    # The active SDK compiles with -Werror under a newer GCC, which turns
    # long-standing warnings (e.g. snprintf truncation, address-of-array)
    # into hard errors. This app built cleanly-with-warnings on the legacy
    # SDK, so drop -Werror to preserve original behaviour.
    for env in list(ctx.all_envs.values()) + [ctx.env]:
        if 'CFLAGS' in env:
            env.CFLAGS = [f for f in env.CFLAGS if f != '-Werror']

    binaries = []
    for platform in ctx.env.TARGET_PLATFORMS:
        ctx.set_env(ctx.all_envs[platform])
        ctx.set_group(ctx.env.PLATFORM_NAME)
        app_elf = '{}/pebble-app.elf'.format(ctx.env.BUILD_DIR)
        ctx.pbl_build(source=ctx.path.ant_glob('src/c/**/*.c'),
                      target=app_elf,
                      bin_type='app')
        binaries.append({'platform': platform, 'app_elf': app_elf})

    ctx.set_group('bundle')
    ctx.pbl_bundle(binaries=binaries, js=[])
